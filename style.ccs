* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --caramel: #b8794f;
    --light-caramel: #d9ad8d;
    --cream: #f8f2eb;
    --gold: #c6a15b;
    --brown: #3c2b24;
    --green: #4f8a63;
    --white: #ffffff;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--cream);
    color: var(--brown);
    padding-bottom: 85px;
}

/* HEADER */

.header {
    height: 75px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(248, 242, 235, 0.96);
    border-bottom: 1px solid rgba(60, 43, 36, 0.08);
    position: sticky;
    top: 0;
    z-index: 50;
}

.logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
}

.logo span {
    font-size: 25px;
    letter-spacing: 4px;
    font-weight: 700;
}

.logo small {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 5px;
    color: var(--gold);
    text-align: center;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.header-actions button {
    background: transparent;
    border: 1px solid rgba(60, 43, 36, 0.2);
    padding: 9px 13px;
    border-radius: 3px;
    color: var(--brown);
    cursor: pointer;
}

/* HERO */

.hero {
    min-height: 470px;
    background:
        linear-gradient(
            90deg,
            rgba(60,43,36,0.72),
            rgba(60,43,36,0.15)
        ),
        linear-gradient(
            135deg,
            #9c694a,
            #e4c4aa
        );

    display: flex;
    align-items: center;
    padding: 60px 8%;
    color: white;
}

.hero-content {
    max-width: 550px;
}

.hero-small {
    letter-spacing: 4px;
    font-size: 11px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(38px, 7vw, 72px);
    line-height: 1.05;
    font-weight: 500;
}

.hero p {
    margin-top: 20px;
    font-size: 16px;
}

.gold-btn {
    margin-top: 30px;
    background: var(--gold);
    color: white;
    border: none;
    padding: 15px 30px;
    cursor: pointer;
    font-size: 14px;
}

/* SECTIONS */

.categories,
.products-section {
    padding: 65px 6%;
}

.section-title {
    text-align: center;
    margin-bottom: 35px;
}

.section-title span,
.small-title {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--gold);
}

.section-title h2,
.section-heading h2 {
    margin-top: 9px;
    font-size: 28px;
    font-weight: 500;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.category-card {
    border: none;
    background: transparent;
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.category-image {
    height: 330px;
    background-size: cover;
    background-position: center;
    transition: transform 0.4s ease;
}

.category-card:hover .category-image {
    transform: scale(1.03);
}

.clothes-image {
    background:
        linear-gradient(135deg, #b98d72, #e4c8b4);
}

.makeup-image {
    background:
        linear-gradient(135deg, #9f6759, #e6c1b7);
}

.accessories-image {
    background:
        linear-gradient(135deg, #806f62, #d2b99c);
}

.category-name {
    position: absolute;
    left: 20px;
    bottom: 20px;
    color: white;
    font-size: 21px;
    letter-spacing: 1px;
}

/* PRODUCTS */

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 25px;
}

.view-all {
    border: none;
    background: transparent;
    color: var(--brown);
    border-bottom: 1px solid var(--brown);
    padding-bottom: 4px;
    cursor: pointer;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.product-card {
    background: white;
    position: relative;
    overflow: hidden;
}

.product-image {
    width: 100%;
    aspect-ratio: 0.85;
    object-fit: cover;
    display: block;
}

.product-info {
    padding: 14px;
}

.product-name {
    font-size: 14px;
    min-height: 35px;
}

.product-price {
    margin-top: 8px;
    color: var(--green);
    font-weight: 700;
}

.old-price {
    margin-left: 8px;
    color: #999;
    text-decoration: line-through;
    font-size: 12px;
}

.discount {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--green);
    color: white;
    padding: 5px 8px;
    font-size: 11px;
}

.add-cart {
    width: 100%;
    margin-top: 12px;
    padding: 10px;
    background: var(--brown);
    color: white;
    border: none;
    cursor: pointer;
}

.add-cart:hover {
    background: var(--caramel);
}

/* SEARCH */

.search-modal {
    position: fixed;
    inset: 0;
    background: rgba(30, 20, 15, 0.65);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
    z-index: 100;
}

.search-modal.active {
    display: flex;
}

.search-box {
    width: min(600px, 90%);
    background: var(--cream);
    padding: 30px;
    position: relative;
}

.close-search {
    position: absolute;
    right: 15px;
    top: 10px;
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
}

.search-box h2 {
    margin-bottom: 20px;
}

#searchInput {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    background: white;
    outline: none;
}

/* CART */

.cart-panel {
    position: fixed;
    top: 0;
    right: -430px;
    width: min(430px, 100%);
    height: 100vh;
    background: var(--cream);
    z-index: 200;
    transition: right 0.3s ease;
    padding: 25px;
    display: flex;
    flex-direction: column;
}

.cart-panel.active {
    right: 0;
}

.cart-header {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #ddd;
    padding-bottom: 18px;
}

.cart-header button {
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
}

#cartItems {
    flex: 1;
    overflow-y: auto;
    padding: 20px 0;
}

.cart-item {
    display: flex;
    gap: 12px;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid #ddd;
}

.cart-item img {
    width: 70px;
    height: 85px;
    object-fit: cover;
}

.cart-item-info {
    flex: 1;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
}

.quantity-controls button {
    border: 1px solid #ccc;
    background: white;
    width: 25px;
    height: 25px;
    cursor: pointer;
}

.cart-bottom {
    border-top: 1px solid #ddd;
    padding-top: 20px;
}

.total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}

#cartTotal {
    color: var(--green);
}

.checkout-btn {
    width: 100%;
    padding: 15px;
    border: none;
    background: var(--brown);
    color: white;
    cursor: pointer;
}

/* OVERLAY */

.overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 150;
}

.overlay.active {
    display: block;
}

/* BOTTOM NAV */

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 70px;
    background: rgba(255,255,255,0.97);
    border-top: 1px solid #ddd;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    z-index: 80;
}

.bottom-nav button {
    border: none;
    background: transparent;
    color: var(--brown);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
}

.nav-icon {
    font-size: 15px;
}

.bottom-nav small {
    font-size: 9px;
}

.cart-icon {
    position: relative;
}

#cartCount {
    position: absolute;
    top: -8px;
    right: -12px;
    background: var(--green);
    color: white;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* MOBILE */

@media (max-width: 700px) {

    .header {
        padding: 0 18px;
        height: 65px;
    }

    .logo span {
        font-size: 20px;
    }

    .hero {
        min-height: 430px;
        padding: 45px 25px;
    }

    .categories,
    .products-section {
        padding: 45px 18px;
    }

    .category-grid {
        grid-template-columns: 1fr;
    }

    .category-image {
        height: 260px;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .product-info {
        padding: 10px;
    }

    .product-name {
        font-size: 12px;
    }

    .section-heading h2 {
        font-size: 21px;
    }
}